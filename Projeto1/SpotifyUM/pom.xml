<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>SpotifyUM</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.8.2</junit.version>
        <jqwik.version>1.7.4</jqwik.version>
        <evosuite.version>1.0.3</evosuite.version>
        <evosuite.cuts>org.Model.SpotifUM,org.Model.Album.Album,org.Model.Music.Music</evosuite.cuts>
        <evosuite.timeInMinutesPerClass>1</evosuite.timeInMinutesPerClass>
        <evosuite.numberOfCores>4</evosuite.numberOfCores>
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.9.11</pitest.version>
        <pitest.junit5.version>1.0.0</pitest.junit5.version>
    </properties>

    <repositories>
        <repository>
            <id>evosuite</id>
            <url>https://www.evosuite.org/m2</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>evosuite</id>
            <url>https://www.evosuite.org/m2</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <!-- Por defeito, exclui os ficheiros ESTest para não quebrar o build normal -->
                    <testExcludes>
                        <testExclude>**/*ESTest.java</testExclude>
                        <testExclude>**/*ESTest_scaffolding.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <argLine>${jacocoArgLine} --add-opens java.desktop/java.awt=ALL-UNNAMED --add-opens java.base/java.net=ALL-UNNAMED --add-exports java.base/sun.net.util=ALL-UNNAMED</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*ESTest.java</exclude>
                        <exclude>**/*ESTest_scaffolding.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Cobertura (mvn verify) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>org/App*</exclude>
                                <exclude>org/View/**</exclude>
                                <exclude>org/Utils/MusicPlayer*</exclude>
                                <exclude>org/Utils/BrowserOpener*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Mutation testing (mvn org.pitest:pitest-maven:mutationCoverage) -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <configuration>
                    <threads>4</threads>
                    <verbose>false</verbose>
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <jvmArgs>
                        <param>-Djava.awt.headless=true</param>
                        <param>--add-opens=java.desktop/java.awt=ALL-UNNAMED</param>
                        <param>--add-opens=java.base/java.net=ALL-UNNAMED</param>
                        <param>--add-exports=java.base/sun.net.util=ALL-UNNAMED</param>
                    </jvmArgs>
                    <targetClasses>
                        <param>org.Model.*</param>
                        <param>org.Controller.*</param>
                        <param>org.Utils.*</param>
                        <param>org.Exceptions.*</param>
                    </targetClasses>
                    <excludedClasses>
                        <param>org.View.*</param>
                        <param>org.Utils.MusicPlayer</param>
                        <param>org.Utils.BrowserOpener</param>
                        <param>org.App</param>
                    </excludedClasses>
                    <excludedTestClasses>
                        <param>org.View.*</param>
                        <param>*ESTest*</param>
                        <param>*ESTest_scaffolding*</param>
                    </excludedTestClasses>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <!-- ================================================================
             Perfil 1: testes normais JUnit 5 (ativo por defeito)
             Comando: mvn test
             ================================================================ -->
        <profile>
            <id>tests-junit5</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-api</artifactId>
                    <version>${junit.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>net.jqwik</groupId>
                    <artifactId>jqwik</artifactId>
                    <version>${jqwik.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                    <version>4.11.0</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.junit.jupiter</groupId>
                    <artifactId>junit-jupiter-engine</artifactId>
                    <version>${junit.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-toolchains-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>toolchain</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <toolchains>
                                <jdk>
                                    <version>17</version>
                                    <vendor>openjdk</vendor>
                                </jdk>
                            </toolchains>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ================================================================
             Perfil 2: gerar testes com EvoSuite
             Comando: mvn compile evosuite:generate evosuite:export -P evosuite-generate
             Depois copiar: cp -r target/generated-test-sources/evosuite/org src/test/java/
             ================================================================ -->
        <profile>
            <id>evosuite-generate</id>
            <properties>
                <maven.compiler.source>8</maven.compiler.source>
                <maven.compiler.target>8</maven.compiler.target>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-toolchains-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>toolchain</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <toolchains>
                                <jdk>
                                    <version>8</version>
                                    <vendor>openjdk</vendor>
                                </jdk>
                            </toolchains>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.evosuite.plugins</groupId>
                        <artifactId>evosuite-maven-plugin</artifactId>
                        <version>${evosuite.version}</version>
                        <configuration>
                            <cuts>${evosuite.cuts}</cuts>
                            <projectCP>${project.build.outputDirectory}</projectCP>
                            <timeInMinutesPerClass>${evosuite.timeInMinutesPerClass}</timeInMinutesPerClass>
                            <numberOfCores>${evosuite.numberOfCores}</numberOfCores>
                            <assertions>true</assertions>
                            <javaCommand>/usr/lib/jvm/java-8-openjdk-amd64/bin/java</javaCommand>
                        </configuration>
                        <executions>
                            <execution>
                                <id>evosuite-generate-tests</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>evosuite-export-tests</id>
                                <phase>process-test-sources</phase>
                                <configuration>
                                    <targetFolder>target/generated-test-sources/evosuite</targetFolder>
                                </configuration>
                                <goals>
                                    <goal>export</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ================================================================
             Perfil 3: correr os testes EvoSuite gerados (*ESTest.java)
             Comando: mvn test -P evosuite-run
             Requer que os ficheiros ESTest estejam em src/test/java/
             ================================================================ -->
       <profile>
    <id>evosuite-run</id>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- Runtime do EvoSuite (EvoRunner, EvoRunnerParameters, EvoAssertions, etc.) -->
        <dependency>
            <groupId>org.evosuite</groupId>
            <artifactId>evosuite-standalone-runtime</artifactId>
            <version>${evosuite.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4 (os testes ESTest usam @RunWith do JUnit 4) -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Vintage engine: permite ao JUnit 5 / Surefire descobrir e correr testes JUnit 4 -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Restantes dependências para não quebrar outros testes no classpath -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Forçar toolchain Java 8 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>8</version>
                            <vendor>openjdk</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <!-- Reativar compilação dos ficheiros ESTest (anula exclusão do build padrão) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testIncludes>
                         <testInclude>**/*ESTest.java</testInclude>
                    </testIncludes>
                    <testExcludes combine.self="override"/>
                </configuration>
            </plugin>

            <!-- Correr apenas os testes ESTest e excluir os testes normais -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <argLine>${jacocoArgLine}</argLine>
                    <includes combine.self="override">
                        <include>**/*ESTest.java</include>
                    </includes>
                    <excludes combine.self="override">
                        <exclude>**/*ESTest_scaffolding.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</profile>
    </profiles>
</project>
